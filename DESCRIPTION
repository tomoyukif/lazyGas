  arrow, jsonlite, gaston, plotly, htmltools, reactable
Suggests: DBI, RSQLite, testthat, BiocStyle, knitr, rmarkdown, text2vec, base64enc,
  shiny, quarto, httr2, curl, rentrez, processx
